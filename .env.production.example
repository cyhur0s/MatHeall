# Jika MatHeal berada di root domain, gunakan "/".
# Jika berada di https://domain.com/matheal/, gunakan "/matheal/".
VITE_BASE_PATH=/

# Backend PHP dan server AI dapat memakai domain yang sama atau subdomain berbeda.
VITE_API_BASE=https://domain-anda.example/backend
VITE_AI_API_BASE=https://domain-anda.example/api
