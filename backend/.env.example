APP_ENV=production
APP_ALLOWED_ORIGIN=https://domain-anda.example
DB_HOST=localhost
DB_PORT=3306
DB_NAME=matheal
DB_USER=matheal_user
DB_PASSWORD=ganti_dengan_password_database
ADMIN_REGISTRATION_KEY=ganti_dengan_kunci_admin_yang_panjang
# Produksi: tutup pendaftaran admin dari halaman publik.
# Aktifkan hanya sementara saat membuat admin pertama, lalu kembalikan ke false.
ADMIN_REGISTRATION_ENABLED=false
AUTH_TOKEN_TTL_HOURS=24

# Digunakan oleh backend/server.js untuk AskMatheal.
AI_ALLOWED_ORIGIN=https://domain-anda.example
PORT=5000
GEMINI_KEY=
PHP_AUTH_URL=https://domain-anda.example/backend/verify_token.php
INTERNAL_API_KEY=ganti_dengan_kunci_internal_acak_yang_panjang
